{
  "name": "@proj-poker/web",
  "private": true,
  "version": "0.0.0",
  "description": "Local Browser UI（Vite + React の SPA）。API キーは扱わず、Runtime の /api だけを呼ぶ（D67）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@proj-poker/engine": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
