{
  "name": "@proj-poker/server",
  "private": true,
  "version": "0.0.0",
  "description": "ローカル Runtime（常駐 Node / Fastify）。Claude API・SQLite はこちら側だけが扱う（D67）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@proj-poker/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:claude": "tsx --conditions=@proj-poker/source src/testing/claude-smoke.ts",
    "smoke:solver": "tsx --conditions=@proj-poker/source src/testing/solver-smoke.ts",
    "eval:opponent": "tsx --conditions=@proj-poker/source src/testing/opponent-eval/run.ts",
    "eval:review": "tsx --conditions=@proj-poker/source src/testing/review-eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@proj-poker/engine": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
