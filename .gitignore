.claude/worktrees/
# Codex レビューモードのリポジトリ上書き（マシンごとに codex-mode.sh set-repo で設定）
.claude/codex-mode
# ローカル専用の Claude 設定・秘密情報
.claude/settings.local.json
.env
.env.*

# 依存・ビルド成果物
node_modules/
dist/
*.tsbuildinfo

